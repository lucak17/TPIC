# Prefer ROCprofiler-SDK. The installed package constrains FIND_API to the
# configured header/library family so consumers cannot silently mix ABIs.
if(NOT LPFxROCTX_FIND_API OR LPFxROCTX_FIND_API STREQUAL "SDK")
  find_path(LPFxROCTX_SDK_INCLUDE_DIR NAMES rocprofiler-sdk-roctx/roctx.h
    HINTS ENV ROCM_PATH PATHS /opt/rocm PATH_SUFFIXES include)
  find_library(LPFxROCTX_SDK_LIBRARY NAMES rocprofiler-sdk-roctx
    HINTS ENV ROCM_PATH PATHS /opt/rocm PATH_SUFFIXES lib lib64)
endif()
set(LPFxROCTX_INCLUDE_DIR "")
set(LPFxROCTX_LIBRARY "")
set(LPFxROCTX_API "")
if((NOT LPFxROCTX_FIND_API OR LPFxROCTX_FIND_API STREQUAL "SDK") AND
   LPFxROCTX_SDK_INCLUDE_DIR AND LPFxROCTX_SDK_LIBRARY)
  set(LPFxROCTX_INCLUDE_DIR "${LPFxROCTX_SDK_INCLUDE_DIR}")
  set(LPFxROCTX_LIBRARY "${LPFxROCTX_SDK_LIBRARY}")
  set(LPFxROCTX_API SDK)
elseif(NOT LPFxROCTX_FIND_API OR LPFxROCTX_FIND_API STREQUAL "LEGACY")
  find_path(LPFxROCTX_LEGACY_INCLUDE_DIR NAMES roctracer/roctx.h
    HINTS ENV ROCM_PATH PATHS /opt/rocm PATH_SUFFIXES include)
  find_library(LPFxROCTX_LEGACY_LIBRARY NAMES roctx64
    HINTS ENV ROCM_PATH PATHS /opt/rocm PATH_SUFFIXES lib lib64)
  set(LPFxROCTX_INCLUDE_DIR "${LPFxROCTX_LEGACY_INCLUDE_DIR}")
  set(LPFxROCTX_LIBRARY "${LPFxROCTX_LEGACY_LIBRARY}")
  set(LPFxROCTX_API LEGACY)
endif()
include(FindPackageHandleStandardArgs)
find_package_handle_standard_args(LPFxROCTX
  REQUIRED_VARS LPFxROCTX_INCLUDE_DIR LPFxROCTX_LIBRARY)
if(LPFxROCTX_FOUND AND NOT TARGET LPFxROCTX::ROCTX)
  add_library(LPFxROCTX::ROCTX UNKNOWN IMPORTED)
  set_target_properties(LPFxROCTX::ROCTX PROPERTIES
    IMPORTED_LOCATION "${LPFxROCTX_LIBRARY}"
    INTERFACE_INCLUDE_DIRECTORIES "${LPFxROCTX_INCLUDE_DIR}")
endif()
mark_as_advanced(LPFxROCTX_SDK_INCLUDE_DIR LPFxROCTX_SDK_LIBRARY
  LPFxROCTX_LEGACY_INCLUDE_DIR LPFxROCTX_LEGACY_LIBRARY)
