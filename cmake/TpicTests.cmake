# CTest exposes focused suites; each case retains its own command and timeout.
# Bracket quoting preserves paths, spaces and semicolons in generated scripts.
function(tpic_quote_test_argument output value)
  set(delimiter "=")
  while("${value}" MATCHES "\\]${delimiter}\\]")
    string(APPEND delimiter "=")
  endwhile()
  set(${output} "[${delimiter}[${value}]${delimiter}]" PARENT_SCOPE)
endfunction()

function(tpic_add_test_case)
  # COMMAND is last. Read its arguments directly from ARGVn: converting them
  # into a CMake list loses empty values and can split literal semicolons.
  set(header)
  set(index 0)
  while(index LESS ARGC AND NOT "${ARGV${index}}" STREQUAL "COMMAND")
    list(APPEND header "${ARGV${index}}")
    math(EXPR index "${index} + 1")
  endwhile()
  math(EXPR command_start "${index} + 1")
  cmake_parse_arguments(_case "RUN_SERIAL"
    "SUITE;NAME;TIMEOUT;SKIP_RETURN_CODE;PROCESSORS" "LABELS;ENVIRONMENT" ${header})
  if(NOT _case_SUITE OR NOT _case_NAME OR command_start GREATER_EQUAL ARGC OR
      _case_UNPARSED_ARGUMENTS OR _case_KEYWORDS_MISSING_VALUES)
    message(FATAL_ERROR "tpic_add_test_case requires SUITE, NAME and COMMAND")
  endif()
  if(NOT _case_TIMEOUT)
    set(_case_TIMEOUT 60)
  endif()
  if(NOT _case_PROCESSORS)
    set(_case_PROCESSORS 1)
  endif()
  get_property(suites GLOBAL PROPERTY TPIC_TEST_SUITES)
  if(NOT _case_SUITE IN_LIST suites)
    set_property(GLOBAL APPEND PROPERTY TPIC_TEST_SUITES "${_case_SUITE}")
  endif()
  get_property(names GLOBAL PROPERTY "${_case_SUITE}_CASE_NAMES")
  if(_case_NAME IN_LIST names)
    message(FATAL_ERROR "Duplicate case ${_case_NAME} in ${_case_SUITE}")
  endif()
  set_property(GLOBAL APPEND PROPERTY "${_case_SUITE}_CASE_NAMES" "${_case_NAME}")
  tpic_quote_test_argument(name "${_case_NAME}")
  set(script "tpic_run_case(NAME ${name} TIMEOUT ${_case_TIMEOUT}")
  if(DEFINED _case_SKIP_RETURN_CODE)
    string(APPEND script " SKIP_RETURN_CODE ${_case_SKIP_RETURN_CODE}")
  endif()
  string(APPEND script " COMMAND")
  if(_case_ENVIRONMENT)
    foreach(argument IN ITEMS "${CMAKE_COMMAND}" -E env ${_case_ENVIRONMENT})
      tpic_quote_test_argument(quoted "${argument}")
      string(APPEND script " ${quoted}")
    endforeach()
  endif()
  set(index ${command_start})
  while(index LESS ARGC)
    tpic_quote_test_argument(quoted "${ARGV${index}}")
    string(APPEND script " ${quoted}")
    math(EXPR index "${index} + 1")
  endwhile()
  string(APPEND script ")\n")
  set_property(GLOBAL APPEND_STRING PROPERTY "${_case_SUITE}_SCRIPT" "${script}")
  get_property(timeout GLOBAL PROPERTY "${_case_SUITE}_TIMEOUT")
  if(NOT timeout)
    set(timeout 0)
  endif()
  math(EXPR timeout "${timeout} + ${_case_TIMEOUT} + 5")
  set_property(GLOBAL PROPERTY "${_case_SUITE}_TIMEOUT" "${timeout}")
  get_property(processors GLOBAL PROPERTY "${_case_SUITE}_PROCESSORS")
  if(NOT processors OR _case_PROCESSORS GREATER processors)
    set_property(GLOBAL PROPERTY "${_case_SUITE}_PROCESSORS" "${_case_PROCESSORS}")
  endif()
  if(_case_RUN_SERIAL)
    set_property(GLOBAL PROPERTY "${_case_SUITE}_RUN_SERIAL" TRUE)
  endif()
  set_property(GLOBAL APPEND PROPERTY "${_case_SUITE}_LABELS" ${_case_LABELS})
endfunction()

# Rank-one native cases optionally use MPIEXEC; multi-rank cases always do.
function(tpic_add_native_case)
  cmake_parse_arguments(PARSE_ARGV 0 _test "RUN_SERIAL"
    "SUITE;NAME;TARGET;RANKS;TIMEOUT;SKIP_RETURN_CODE" "ARGUMENTS;LABELS")
  if(NOT _test_SUITE OR NOT _test_NAME OR NOT _test_TARGET OR
      _test_UNPARSED_ARGUMENTS OR _test_KEYWORDS_MISSING_VALUES)
    message(FATAL_ERROR "tpic_add_native_case requires SUITE, NAME and TARGET")
  endif()
  if(NOT TARGET "${_test_TARGET}")
    message(FATAL_ERROR "Unknown test target ${_test_TARGET}")
  endif()
  if(NOT _test_RANKS)
    set(_test_RANKS 1)
  endif()
  if(NOT _test_RANKS MATCHES "^[1-9][0-9]*$")
    message(FATAL_ERROR "${_test_NAME}: RANKS must be a positive integer")
  endif()
  set(options)
  if(LPFX_TEST_USE_MPIEXEC OR _test_RANKS GREATER 1)
    if(NOT MPIEXEC_EXECUTABLE OR NOT MPIEXEC_NUMPROC_FLAG)
      message(FATAL_ERROR "${_test_NAME}: MPIEXEC_EXECUTABLE and MPIEXEC_NUMPROC_FLAG required")
    endif()
    set(command ${MPIEXEC_EXECUTABLE} ${MPIEXEC_NUMPROC_FLAG} ${_test_RANKS}
      ${MPIEXEC_PREFLAGS} $<TARGET_FILE:${_test_TARGET}>
      ${MPIEXEC_POSTFLAGS} ${_test_ARGUMENTS})
    list(APPEND options RUN_SERIAL)
  else()
    set(command $<TARGET_FILE:${_test_TARGET}> ${_test_ARGUMENTS})
    if(_test_RUN_SERIAL)
      list(APPEND options RUN_SERIAL)
    endif()
  endif()
  foreach(option IN ITEMS TIMEOUT SKIP_RETURN_CODE)
    if(DEFINED _test_${option})
      list(APPEND options ${option} "${_test_${option}}")
    endif()
  endforeach()
  if(_test_LABELS)
    list(APPEND options LABELS ${_test_LABELS})
  endif()
  tpic_add_test_case(SUITE "${_test_SUITE}" NAME "${_test_NAME}"
    PROCESSORS "${_test_RANKS}" ${options} COMMAND ${command})
endfunction()

function(tpic_host_test suite name source)
  add_executable(tpic_test_${name} ${source})
  target_link_libraries(tpic_test_${name} PRIVATE ${ARGN})
  tpic_add_native_case(SUITE ${suite} NAME ${name} TARGET tpic_test_${name})
endfunction()

function(tpic_device_test suite name source)
  add_executable(tpic_test_${name}_device ${source})
  tpic_device_source(tpic_test_${name}_device ${source})
  target_link_libraries(tpic_test_${name}_device PRIVATE ${ARGN})
  tpic_add_native_case(SUITE ${suite} NAME ${name} TARGET tpic_test_${name}_device
    LABELS device RUN_SERIAL SKIP_RETURN_CODE 77 TIMEOUT 60)
endfunction()

function(tpic_register_test_suites)
  get_property(suites GLOBAL PROPERTY TPIC_TEST_SUITES)
  list(LENGTH suites count)
  if(count GREATER 20)
    message(FATAL_ERROR "TPIC allows at most 20 CTest suites; found ${count}")
  endif()
  foreach(suite IN LISTS suites)
    get_property(script GLOBAL PROPERTY "${suite}_SCRIPT")
    set(path "${CMAKE_CURRENT_BINARY_DIR}/suites/$<CONFIG>/${suite}.cmake")
    file(GENERATE OUTPUT "${path}" CONTENT
      "include(\"${PROJECT_SOURCE_DIR}/tests/support/run_suite.cmake\")\n${script}tpic_finish_suite()\n")
    add_test(NAME ${suite} COMMAND "${CMAKE_COMMAND}" -P "${path}")
    foreach(property IN ITEMS TIMEOUT PROCESSORS RUN_SERIAL LABELS)
      get_property(value GLOBAL PROPERTY "${suite}_${property}")
      if(value)
        if(property STREQUAL "LABELS")
          list(REMOVE_DUPLICATES value)
        endif()
        set_tests_properties(${suite} PROPERTIES ${property} "${value}")
      endif()
    endforeach()
    # Match only the final summary marker, never text from a failed child.
    set_tests_properties(${suite} PROPERTIES
      SKIP_REGULAR_EXPRESSION "\nTPIC_SUITE_SKIPPED: all cases skipped\n$")
  endforeach()
  message(STATUS "TPIC CTest suites: ${count} (maximum 20)")
endfunction()
