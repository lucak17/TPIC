# INPUT FILE for a quasi-1D cold symmetric electron two-stream instability
#
# Normalization:
#   omega_pi = 1, c = 1, d_i = c / omega_pi = 1
#   mu = m_i / m_e = 2000, so omega_pe = sqrt(mu) and d_e = 1/sqrt(mu)
#   the total equilibrium electron density is n_e = 1, split equally between
#   the two electron populations; the ion density is n_i = 1.
#
# The x box is one electron-scale wavelength, Lx = 2*pi*d_e.  Therefore the
# seeded Fourier mode m has k*d_e = m.  For m = 3 and counter-stream speed
# u_b = 0.2, a = k*u_b/omega_pe = 0.6, close to the fastest-growing cold
# symmetric two-stream mode (a = sqrt(3/8) = 0.612372...).
#
# Cold symmetric-beam dispersion relation, with Omega = omega/omega_pe:
#   1 - 1/[2*(Omega-a)^2] - 1/[2*(Omega+a)^2] = 0
# The unstable branch has
#   gamma/omega_pe = sqrt(0.5*sqrt(1 + 8*a^2) - a^2 - 0.5)
#                  = 0.3533918224571849,
#   gamma/omega_pi = 15.80416275413605.
# Thus the electric-mode amplitude grows as exp(gamma*t) in the linear regime;
# its squared amplitude (mode energy) grows as exp(2*gamma*t).

# %%%%%%%%%%%%%%%%%%% Input / output %%%%%%%%%%%%%%%%%%%
SaveDirName    = data_twoStream1D_ecsim
RestartDirName = restart_twoStream1D_ecsim

Case              = TwoStream
WriteMethod       = pvtk    # pvtk (parallel VTK), adios2 or hdf5
# Per-channel overrides of WriteMethod (same values); commented out, the channel inherits WriteMethod.
# FieldWriteMethod     = pvtk
# ParticlesWriteMethod = pvtk
RestartWriteMethod = default   # Checkpoint engine: adios2 or hdf5; default: ADIOS2 if built, else HDF5, else none
SimulationName    = twoStream1D_cold_symmetric_mu2000

# %%%%%%%%%%%%%%%%%%% Two-stream density seed %%%%%%%%%%%%%%%%%%%
# Both electron populations receive the same relative density modulation:
#   n_e(x) = n_e*[1 + delta*cos(k*x + phase)],  k = 2*pi*m/Lx.
# Ions remain uniform.  In the field/density normalization used here, Gauss's
# law gives the matching longitudinal field
#   Ex(x,0) = -(n_e*delta/k)*sin(k*x + phase).
# For n_e=1, delta=1e-4, m=3, and k=134.1640786499874, the peak seed field is
# |Ex| = 7.453559924999298e-7.  The sign follows from the negative perturbed
# electron charge density.  Change only the three keys below to select another
# resolvable periodic seed without changing the equilibrium populations.
TwoStreamSeedModeX            = 3
TwoStreamSeedDensityAmplitude = 1.0e-4
TwoStreamSeedPhase            = 0.0

# %%%%%%%%%%%%%%%%%%% Initial electromagnetic fields %%%%%%%%%%%%%%%%%%%
B0x = 0.0
B0y = 0.0
B0z = 0.0

# %%%%%%%%%%%%%%%%%%% Time integration %%%%%%%%%%%%%%%%%%%
# dt*omega_pe = 0.025 and t_end*omega_pe = 50.  The theoretical mode gains
# about 10.60 amplitude e-foldings up to omega_pe*t = 30, where it saturates;
# fit only the pre-saturation interval when measuring the numerical growth rate.
dt      = 5.590169943749475e-4
ncycles = 2000
th      = 0.5
c       = 1.0

# Disable smoothing so that the seeded Fourier-mode growth is measured without
# an additional mode-dependent filter.
# ECSimSmoothing = none (off) or energy_conserving; ECSimSmoothingOperator = face7 or binomial27.
# face7: each pass gives Smooth*f + (1-Smooth)/6 * (sum of the six face neighbours); binomial27: fixed
# [1,2,1]^3/64 weights. Active only with energy_conserving, SmoothNiter > 0 and Smooth < 1 (Smooth in [0, 1]).
Smooth                 = 0.0
SmoothNiter            = 0
ECSimSmoothing         = none
ECSimSmoothingOperator = face7

# %%%%%%%%%%%%%%%%%%% Quasi-1D periodic domain %%%%%%%%%%%%%%%%%%%
# Cubic cells:
#   dx = Lx/128 = Ly/4 = Lz = 0.001097627301725113 d_i.
# Four y cells and one z cell retain the 3D field/particle data layout while
# all initialized quantities vary only along x.
Lx = 0.1404962946208145
Ly = 0.004390509206900453
Lz = 0.001097627301725113

nxc = 128
nyc = 4
nzc = 1

# %%%%%%%%%%%%%%%%%%% MPI topology %%%%%%%%%%%%%%%%%%%
XLEN = 1
YLEN = 1
ZLEN = 1

# A single Fourier mode requires periodic fields and particles on every axis.
PERIODICX = true
PERIODICY = true
PERIODICZ = true

PERIODICX_P = true
PERIODICY_P = true
PERIODICZ_P = true

# %%%%%%%%%%%%%%%%%%% Species %%%%%%%%%%%%%%%%%%%
# Species 0/1 are the +x/-x electron beams; species 2 is the ion population.
# qom = q/m.  qom_e = -2000 and qom_i = +1 give m_i/m_e = 2000, making the
# ions quasi-stationary on the electron-instability time scale.
ns = 3

rhoINIT   = 0.5  0.5  1.0

# 16 x 4 x 4 = 256 particles/cell/species.
npcelx = 16  16  16
npcely = 4   4   4
npcelz = 4   4   4

qom = -2000.0  -2000.0  1.0

# Cold populations: zero thermal spread in every velocity component.
uth = 0.0  0.0  0.0
vth = 0.0  0.0  0.0
wth = 0.0  0.0  0.0

# Equal and opposite electron drifts give zero equilibrium current.  Ions and
# all transverse bulk velocities are stationary.
u0 = 0.2  -0.2  0.0
v0 = 0.0   0.0  0.0
w0 = 0.0   0.0  0.0

# Per species: shift the loaded velocities so that the species mean equals (u0, v0, w0).
CenterInitialVelocity = false  false  false

# Particle positions: QuietStart = true places every particle at the centre of its subcell (npcelx*npcely*npcelz
# subcells per cell), the same points for every species, so species with equal npcel* sit on one another;
# false (the default) draws a random point in each subcell, a different one for every species.
QuietStart = true

# %%%%%%%%%%%%%%%%%%% Boundary conditions %%%%%%%%%%%%%%%%%%%
# PERIODIC*=true and PERIODIC*_P=true govern the actual boundary behavior.  The
# face values are retained because they are part of a complete deck.

# Electromagnetic field: 0 = perfect electric conductor (PEC); 1 = perfect magnetic conductor (PMC);
# 2 = open (--check-input admits it; --initialize and --run reject it).
bcEMfaceXright = 0
bcEMfaceXleft  = 0
bcEMfaceYright = 0
bcEMfaceYleft  = 0
bcEMfaceZright = 0
bcEMfaceZleft  = 0

# Particles: 1 = perfect mirror; 0 = exit, 2 = reemission and 3/4 = open out/in
# are not implemented and are refused on a wall.
bcPfaceXright = 1
bcPfaceXleft  = 1
bcPfaceYright = 1
bcPfaceYleft  = 1
bcPfaceZright = 1
bcPfaceZleft  = 1

# %%%%%%%%%%%%%%%%%%% Numerics and output %%%%%%%%%%%%%%%%%%%
GMREStol   = 1.0e-16

# Write E to VTK every cycle:
#   Delta(t*omega_pe) = dt*omega_pe = 0.025.
FieldOutputCycle = 1
# FieldOutputTag: B, E and Gauss (cell residual) joined by +.
FieldOutputTag   = E
# MomentsOutputTag: rho, J, PXX, PXY, PXZ, PYY, PYZ, PZZ joined by +; <name> selects every species,
# <name>_tot the total, <name><s> species s. Commented out: with FieldOutputTag set, no moment is written.
# MomentsOutputTag = rho+J

# Scalar diagnostics may be useful for identifying the nonlinear transition.
DiagnosticsOutputCycle = 1
# Console energy cadence (0 reports only the final state)
DiagnosticEnergyCycle = 1
# Gauss-law residual cadence: gauss.csv and one log line per sample (0 disables)
DiagnosticGaussCycle = 0

# No particle dumps and no restart checkpoints for this validation run.
ParticlesOutputCycle = 0
# ParticlesOutputTag has no effect: a particle snapshot always holds position, velocity, charge and id.
# ParticlesOutputTag = position+velocity+q
RestartOutputCycle   = 0
CallFinalize         = 1       # also checkpoint the final state when RestartOutputCycle > 0

# From the repository root, analyze the seeded Ex mode with:
#   python3 tools/postprocessing/analyze_two_stream.py \
#     --run-dir <run-dir> --input input/twoStream1D.inp
# Here <run-dir> is the directory from which the simulation was launched; the
# analyzer resolves SaveDirName relative to it, compares the measured amplitude
# slope with the cold rate above, and reports/plots the mode-m growth history.
