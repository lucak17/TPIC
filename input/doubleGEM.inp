# INPUT FILE for double GEM challenge case
# 2 species, double Harris current sheet, ECSIM
# GEM reconnection challenge of J. Birn et al., J. Geophys. Res. 106, 3715 (2001); box, mass ratio
# and densities differ from the challenge.

#  %%%%%%%%%%%%%%%%%%% Input/Output flags %%%%%%%%%%%%%%%%%%
SaveDirName    = data    # Output directory
RestartDirName = data    # Checkpoint directory, managed by TPIC

#  %%%%%%%%%%%%%%%%%%% Input/Output flags %%%%%%%%%%%%%%%%%%
Case              = DoubleGEM                         # Case [ GEM | DoubleGEM | ... ]
WriteMethod       = pvtk                              # Output engine: pvtk (parallel VTK), adios2 or hdf5
# Per-channel overrides of WriteMethod (same values); commented out, the channel inherits WriteMethod.
# FieldWriteMethod     = pvtk
# ParticlesWriteMethod = pvtk
RestartWriteMethod = default   # Checkpoint engine: adios2 or hdf5; default: ADIOS2 if built, else HDF5, else none
SimulationName    = DoubleGEM                         # Simulation name for the output

#  %%%%%%%%%%%%%%%%%%% Magnetic Reconnection %%%%%%%%%%%%%%%%%%
# Uniform background magnetic field.
B0x = 0.0
B0y = 0.0
B0z = 0.0
# Case-specific Harris reconnecting field amplitude.
HarrisB0x = 0.0097

delta = 0.5

#  %%%%%%%%%%%%%%%%%%% TIME %%%%%%%%%%%%%%%%%%
dt = 0.1               # dt = time step  
ncycles = 201          # cycles
th = 0.5               # th = decentering parameter
c = 1.0                # c = light speed 

#  %%%%%%%%%%%%%%%%%%% SMOOTH %%%%%%%%%%%%%%%%%%
# ECSimSmoothing = none (off) or energy_conserving; ECSimSmoothingOperator = face7 or binomial27.
# face7: each pass gives Smooth*f + (1-Smooth)/6 * (sum of the six face neighbours); binomial27: fixed
# [1,2,1]^3/64 weights. Active only with energy_conserving, SmoothNiter > 0 and Smooth < 1 (Smooth in [0, 1]).
Smooth = 0.5           # Smoothing factor
SmoothNiter = 6        # Smoothing passes
ECSimSmoothing = none
ECSimSmoothingOperator = face7


# %%%%%%%%%%%%%%%%%% BOX SIZE %%%%%%%%%%%%%%%
Lx =   25.0            # Lx = simulation box length - x direction   
Ly =   12.5            # Ly = simulation box length - y direction
Lz =   1.0             # Lz = simulation box length - z direction   

nxc =  128             # nxc = number of cells - x direction (test size; full size 256)
nyc =  64              # nyc = number of cells - y direction (test size; full size 128)
nzc =  1               # nzc = number of cells - z direction        

# %%%%%%%%%%%%%%%%%% MPI TOPOLOGY %%%%%%%%%%%%%%%
XLEN = 2               # Number of subdomains in the X direction
YLEN = 2               # Number of subdomains in the Y direction
ZLEN = 1               # Number of subdomains in the Z direction

# %%%%%%%%%%%% Periodicity in each direction %%%%%%%%%%%%%%%
PERIODICX       = true                  # In direction X (true/false or 1/0)
PERIODICY       = true                  # In direction Y (true/false or 1/0)
PERIODICZ       = true                  # In direction Z (true/false or 1/0)
PERIODICX_P     = true                  # Particles in direction X (defaults to PERIODICX when omitted)
PERIODICY_P     = true                  # Particles in direction Y (defaults to PERIODICY when omitted)
PERIODICZ_P     = true                  # Particles in direction Z (defaults to PERIODICZ when omitted)

# %%%%%%%%%%%%%% PARTICLES %%%%%%%%%%%%%%%%%
#    0 = electrons
#    1 = protons
# %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

ns = 2                                 # Number of species

rhoINIT         = 1.0  1.0             # Initial density (make sure you are neutral)

npcelx          = 4   4                # Particles per cell in X (test size; full size 8)
npcely          = 4   4                # Particles per cell in Y (test size; full size 8)
npcelz          = 4   4                # Particles per cell in Z (test size; full size 8)

qom             = -256.0  1.0          # Charge/mass ratio
uth             = 0.045   0.0063       # Thermal velocity in X
vth             = 0.045   0.0063       # Thermal velocity in Y
wth             = 0.045   0.0063       # Thermal velocity in Z
u0              = 0.0     0.0          # Drift velocity in X
v0              = 0.0     0.0          # Drift velocity in Y
w0              = 0.00325 -0.01624     # Drift velocity in Z (times -tanh((y-Ly/2)/delta) for DoubleGEM)
# Per species: shift the loaded velocities so that the species mean equals that of the drift its case loads.
CenterInitialVelocity = false false

# Particle positions: QuietStart = true places every particle at the centre of its subcell (npcelx*npcely*npcelz
# subcells per cell), the same points for every species, so species with equal npcel* sit on one another;
# false (the default) draws a random point in each subcell, a different one for every species.
QuietStart = true

# %%%%%%%%%%%% boundary conditions %%%%%%%%%%%%%%%
    
# EM field boundary condition
# 0 = perfect electric conductor (PEC)
# 1 = perfect magnetic conductor (PMC)
# 2 = open (--check-input admits it; --initialize and --run reject it)
bcEMfaceXright = 0
bcEMfaceXleft =  0
bcEMfaceYright = 0
bcEMfaceYleft =  0
bcEMfaceZright = 0
bcEMfaceZleft =  0
    
# Particles Boundary condition
# 1 = perfect mirror
# 0 = exit, 2 = reemission, 3 = open out, 4 = open in: not implemented, refused on a wall
bcPfaceXright = 1
bcPfaceXleft =  1
bcPfaceYright = 1
bcPfaceYleft =  1
bcPfaceZright = 1
bcPfaceZleft =  1

# %%%%%%%%%%%% Numerics options %%%%%%%%%%%%%%%
GMREStol               = 1E-12    # GMRES solver stopping criterion tolerance
FieldOutputCycle       = 20       # Output for field (if 0 it does not save fields data)
# FieldOutputTag: B, E and Gauss (cell residual) joined by +. MomentsOutputTag: rho, J, PXX, PXY, PXZ, PYY, PYZ, PZZ joined by +;
# <name> selects every species, <name>_tot the total, <name><s> species s. Pressure is off unless named.
# With both tags omitted, B, E, rho and J (total and per species) are written, as selected here.
FieldOutputTag         = B+E
MomentsOutputTag       = rho+rho_tot+J+J_tot
ParticlesOutputCycle   = 5000     # Particle output cadence (0 disables; cycle 0 and the final state are always written)
# ParticlesOutputTag has no effect: a particle snapshot always holds position, velocity, charge and id.
# ParticlesOutputTag = position+velocity+q
RestartOutputCycle     = 0        # Checkpoint cadence (0 disables)
CallFinalize           = 1        # Also checkpoint the final state when RestartOutputCycle > 0
DiagnosticsOutputCycle = 1        # diagnostics.csv cadence (0 disables; defaults to FieldOutputCycle when omitted)
DiagnosticEnergyCycle = 1         # console energy cadence (0 reports only the final state)
DiagnosticGaussCycle = 0          # Gauss-law residual cadence: gauss.csv and one log line per sample (0 disables)
