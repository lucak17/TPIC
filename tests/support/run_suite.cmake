# Run each check in a separate process so MPI/device lifetimes stay isolated.
set(_tpic_suite_passed 0)
set(_tpic_suite_skipped 0)
set(_tpic_suite_failed 0)

function(tpic_run_case)
  # COMMAND consumes the remaining raw arguments. CMake lists cannot represent
  # every argv: empty strings and unmatched brackets are significant, and case
  # option names can also be valid command arguments.
  set(index 0)
  set(command_start -1)
  while(index LESS ARGC)
    set(option "${ARGV${index}}")
    math(EXPR index "${index} + 1")
    if(option STREQUAL "COMMAND")
      set(command_start ${index})
      break()
    endif()
    if(NOT option MATCHES "^(NAME|TIMEOUT|SKIP_RETURN_CODE)$" OR
        index GREATER_EQUAL ARGC OR DEFINED _case_${option})
      message(FATAL_ERROR "Malformed suite case option: ${option}")
    endif()
    set(_case_${option} "${ARGV${index}}")
    math(EXPR index "${index} + 1")
  endwhile()
  if(NOT DEFINED _case_NAME OR "${_case_NAME}" STREQUAL "" OR
      NOT DEFINED _case_TIMEOUT OR command_start LESS 0 OR
      command_start GREATER_EQUAL ARGC)
    message(FATAL_ERROR "Suite cases require NAME, TIMEOUT and COMMAND")
  endif()
  if(NOT _case_TIMEOUT MATCHES "^[0-9]+([.][0-9]+)?$" OR
      _case_TIMEOUT LESS_EQUAL 0)
    message(FATAL_ERROR "Invalid suite case timeout: ${_case_TIMEOUT}")
  endif()

  set(command "execute_process(COMMAND")
  while(index LESS ARGC)
    set(argument "${ARGV${index}}")
    set(delimiter "=")
    string(FIND "${argument}" "]${delimiter}]" collision)
    while(NOT collision EQUAL -1)
      string(APPEND delimiter "=")
      string(FIND "${argument}" "]${delimiter}]" collision)
    endwhile()
    string(APPEND command " [${delimiter}[${argument}]${delimiter}]")
    math(EXPR index "${index} + 1")
  endwhile()
  string(APPEND command " TIMEOUT ${_case_TIMEOUT} RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)")
  message(STATUS "Running ${_case_NAME}")
  cmake_language(EVAL CODE "${command}")
  if(NOT "${output}${error}" STREQUAL "")
    message("${output}${error}")
  endif()
  if("${result}" STREQUAL "0")
    message(STATUS "PASS ${_case_NAME}")
    math(EXPR count "${_tpic_suite_passed} + 1")
    set(_tpic_suite_passed ${count} PARENT_SCOPE)
  elseif(DEFINED _case_SKIP_RETURN_CODE AND "${result}" STREQUAL "${_case_SKIP_RETURN_CODE}")
    message(STATUS "SKIP ${_case_NAME} (exit ${result})")
    math(EXPR count "${_tpic_suite_skipped} + 1")
    set(_tpic_suite_skipped ${count} PARENT_SCOPE)
  else()
    message(STATUS "FAIL ${_case_NAME} (${result})")
    math(EXPR count "${_tpic_suite_failed} + 1")
    set(_tpic_suite_failed ${count} PARENT_SCOPE)
  endif()
endfunction()

function(tpic_finish_suite)
  message(STATUS "Suite: ${_tpic_suite_passed} passed, ${_tpic_suite_skipped} skipped, ${_tpic_suite_failed} failed")
  if(_tpic_suite_failed GREATER 0)
    message(FATAL_ERROR "${_tpic_suite_failed} suite case(s) failed; see FAIL entries above")
  elseif(_tpic_suite_passed EQUAL 0 AND _tpic_suite_skipped GREATER 0)
    message("TPIC_SUITE_SKIPPED: all cases skipped")
  elseif(_tpic_suite_passed EQUAL 0)
    message(FATAL_ERROR "Empty test suite")
  endif()
endfunction()
