function(run expected pattern)
  execute_process(COMMAND "${TPIC_EXECUTABLE}" ${ARGN}
    WORKING_DIRECTORY "${TEST_DIRECTORY}"
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if(NOT status EQUAL expected OR NOT "${output}${error}" MATCHES "${pattern}")
    message(FATAL_ERROR "Unexpected result ${status}, expected ${expected} / ${pattern}:\n${output}${error}")
  endif()
endfunction()

