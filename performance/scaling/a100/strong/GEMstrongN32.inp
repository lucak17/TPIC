SaveDirName = data
RestartDirName = data

# Simulation configuration
Case              = GEM       # Select the case
WriteMethod       = pvtk     # parallel VTK
SimulationName    = scalingGEM3D  # Simulation name for the output

#  %%%%%%%%%%%%%%%%%%% Magnetic Reconnection %%%%%%%%%%%%%%%%%%
# Uniform background field and Harris-sheet amplitude are configured separately.
B0x = 0.0
B0y = 0.0
B0z = 0.0
HarrisB0x = 0.0195
delta = 0.5


#  %%%%%%%%%%%%%%%%%%% TIME %%%%%%%%%%%%%%%%%%
dt = 0.01          # dt = time step
ncycles = 101     # one warm-up cycle followed by 100 measured cycles
th = 0.5          # th =   decentering parameter
c = 1.0

#  %%%%%%%%%%%%%%%%%%% SMOOTH %%%%%%%%%%%%%%%%%%
Smooth = 0.2      # Smoothing factor (inactive when ECSimSmoothing=none)
SmoothNiter = 6   # Smoothing iterations
ECSimSmoothing = none
ECSimSmoothingOperator = face7

Lx = 20   # Lx = simulation box length - x direction
Ly = 20   # Ly = simulation box length - y direction
Lz = 20    # Lz = simulation box length - z direction
nxc = 128  # nxc = number of cells - x direction
nyc = 128  # nyc = number of cells - y direction
nzc = 128  # nzc = number of cells - z direction

# %%%%%%%%%%%%%% MPI TOPOLOGY %%%%%%%%%%%%%%
# number of MPI subdomains in each direction
XLEN = 8
YLEN = 4
ZLEN = 4
# field periodicity in each direction (true/false or 1/0); particles follow it
PERIODICX = true
PERIODICY = false
PERIODICZ = true


# %%%%%%%%%%%%%% PARTICLES %%%%%%%%%%%%%%%%%
#    ns = number of species
#    0 = electrons
#    1 = protons
#    ...
ns = 4

# qom = charge-to-mass ratio for each species
qom = -64.0 1.0 -64 1.0

# Initial density (make sure that plasma is neutral)
rhoINIT = 1.0 1.0 0.1 0.1

# npcelx = number of particles per cell - Direction X
npcelx = 7 7 7 7
# npcely = number of particles per cell - Direction Y
npcely = 8 8 8 8
# npcelz = number of particles per cell - Direction Z
npcelz = 5 5 5 5


# uth = thermal velocity for different species - Direction X
uth  = 0.045 0.0126 0.045 0.0126
# vth = thermal velocity for different species - Direction Y
vth  = 0.045 0.0126 0.045 0.0126
# wth = thermal velocity for different species - Direction Z
wth  = 0.045 0.0126 0.045 0.0126
# u0 = drift velocity - Direction X
u0 = 0.0 0.0 0.0 0.0
# v0 = drift velocity - Direction Y
v0 = 0.0 0.0 0.0 0.0
# w0 = drift velocity - Direction Z
w0 = 0.0065 -0.0325 0.0 0.0

# &&&&&&&&&&&& boundary conditions &&&&&&&&&&&&&&&

#    EM field boundary condition
#    0 = perfect electric conductor (PEC)
#    1 = perfect magnetic conductor (PMC)

    bcEMfaceXright = 0
    bcEMfaceXleft =  0
    bcEMfaceYright = 0
    bcEMfaceYleft =  0
    bcEMfaceZright = 0
    bcEMfaceZleft =  0
#    Particles Boundary condition
#    1 = perfect mirror
#    0 = exit, 2 = reemission: not implemented, refused on a wall
#    A periodic particle topology overrides the corresponding face condition.
    bcPfaceXright = 1
    bcPfaceXleft =  1
    bcPfaceYright = 1
    bcPfaceYleft =  1
    bcPfaceZright = 1
    bcPfaceZleft =  1

# GMRES solver stopping criterion tolerance
   GMREStol = 1E-5
# Output for field
  FieldOutputCycle = 0
  DiagnosticsOutputCycle = 0
  DiagnosticEnergyCycle = 0   # console energy only at the final state
#   FieldOutputTag   = B+E
#   MomentsOutputTag = rho+PXX+PXY+PXZ+PYY+PYZ+PZZ
# Particle output (zero disables it)
   ParticlesOutputCycle = 0
#   ParticlesOutputTag = position+velocity+q
# restart cycle
   RestartOutputCycle = 0
